# Backend Environment Configuration

PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/qiflow_dev

# JWT Secrets
JWT_SECRET=dev_jwt_secret_key_change_in_production
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_change_in_production

# Redis & Frontend
REDIS_URL=redis://localhost:6379
FRONTEND_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:3000

# Quai RPC Configuration
QUAI_RPC_URL=https://rpc.sandbox.quai.network
QUAI_NETWORK=testnet

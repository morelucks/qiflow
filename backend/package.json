{
  "name": "@qiflow/backend",
  "version": "0.0.1",
  "private": true,
  "description": "QiFlow REST API server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc && cp src/openapi.yaml dist/",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "type-check": "prisma generate && tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@qiflow/shared": "*",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.1.2",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "ethers": "^6.13.0",
    "express": "4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "8.0.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "9.6.0",
    "pino-pretty": "13.0.0",
    "rate-limit-redis": "^6.0.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@qiflow/config": "*",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.10.7",
    "prisma": "^6.19.3",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}

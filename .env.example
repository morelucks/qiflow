# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/qiflow_dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_me_generate_a_real_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_generate_a_different_real_secret_min_32_chars

# ─── Quai Network ─────────────────────────────────────────────────────────────
QUAI_RPC_URL=https://rpc.sandbox.quai.network
QUAI_NETWORK=testnet   # testnet | mainnet

# Per-shard RPC endpoints (used by payment monitor — issue #18)
RPC_CYPRUS1=https://rpc.sandbox.quai.network
RPC_CYPRUS2=https://rpc.sandbox.quai.network
RPC_CYPRUS3=https://rpc.sandbox.quai.network
RPC_PAXOS1=https://rpc.sandbox.quai.network
RPC_PAXOS2=https://rpc.sandbox.quai.network
RPC_PAXOS3=https://rpc.sandbox.quai.network
RPC_HYDRA1=https://rpc.sandbox.quai.network
RPC_HYDRA2=https://rpc.sandbox.quai.network
RPC_HYDRA3=https://rpc.sandbox.quai.network
CONFIRMATION_THRESHOLD=5

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── API ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CHECKOUT_BASE_URL=http://localhost:3000

# ─── Webhook signing ──────────────────────────────────────────────────────────
# 32-byte AES key for encrypting per-webhook HMAC secrets at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET_KEY=change_me_generate_a_real_32_byte_hex_key
